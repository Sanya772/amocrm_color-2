        }

        h4 { margin: 0 0 15px 0; color: #2d3748; font-size: 16px; }

        .settings-panel {
            background: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .color-row {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .color-label {
            min-width: 130px; 
            margin-right: 10px; 
            color: #4a5568; 
            font-weight: 500;
        }

        input[type="color"] {
            border: none;
            cursor: pointer;
            height: 34px;
            width: 42px;
            border-radius: 6px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
            margin-right: 8px;
        }

